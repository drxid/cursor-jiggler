{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursor Jiggler",
  "version": "1.0.0",
  "identifier": "com.jig.cursorjiggler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cursor Jiggler",
        "width": 420,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/drxid/cursor-jiggler/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5REYyNjNCRDkxRjgyODAKUldTQWdoL1pPeWJmS2RTQkQ3TzEreG9qQnFIQUxWNW1rbENpQUpucFd3emxod1I1QU54Z3R1MFYK"
    }
  }
}
